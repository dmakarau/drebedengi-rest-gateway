{
  "permissions": {
    "allow": [
      "Bash(go build ./...)",
      "Bash(go test ./...)",
      "Bash(go test -run *)",
      "Bash(go test ./... -run *)",
      "Bash(go vet ./...)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(go tool cover *)",
      "Bash(golangci-lint run*)",
      "Bash(make *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git stash list)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-ai-attribution.sh"
          }
        ]
      }
    ]
  }
}
